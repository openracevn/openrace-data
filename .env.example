# ── Ingestion Worker (worker/) ────────────────────────────────────────────────
# Set these as Worker secrets: npx wrangler secret put <NAME> --config worker/wrangler.toml
# For `npm run worker:dev`, put them in worker/.dev.vars instead.

# Firecrawl account webhook secret (firecrawl.dev → Settings → Advanced).
# Firecrawl signs each webhook body with it (X-Firecrawl-Signature: sha256=<hmac>).
FIRECRAWL_WEBHOOK_SECRET=

# Firecrawl API key: the Worker reads monitor check results, scripts create the monitor.
FIRECRAWL_API_KEY=

# Fine-grained GitHub PAT scoped to openracevn/data with "Contents: read and write".
# Must be a PAT or GitHub App token (not Actions' GITHUB_TOKEN) so commits trigger workflows.
GITHUB_TOKEN=
GITHUB_OWNER=openracevn
GITHUB_REPO=data
GITHUB_BRANCH=main

# ── GitHub Actions (repo Settings → Secrets and variables → Actions) ──────────
# Discord channel webhook for push summaries. Leave empty to skip.
DISCORD_WEBHOOK_URL=

# openrace-api resync endpoint. Placeholder until openrace-api exists; empty = skip.
SYNC_WEBHOOK_URL=

# ── Local scripts only ────────────────────────────────────────────────────────
# Deployed Worker URL, used by `npm run monitor:create`.
INGEST_WEBHOOK_URL=https://openrace-ingest.<your-subdomain>.workers.dev/webhooks/firecrawl
