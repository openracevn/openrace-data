# Local values for scripts; copy to .env (gitignored). In GitHub Actions the same
# values come from repo secrets (Settings → Secrets and variables → Actions).

# Firecrawl API key. Actions secret: FIRECRAWL_API_KEY.
FIRECRAWL_API_KEY=

# Fine-grained GitHub PAT scoped to openracevn/openrace-data with "Contents: read and write".
# Only needed to commit (check.ts without --dry-run, sync-cli.ts --commit).
# Actions secret: OPENRACE_BOT_TOKEN. Must be a PAT, not Actions' built-in token,
# so the checker's commits trigger main.yml (validation + Discord).
GITHUB_TOKEN=
GITHUB_OWNER=openracevn
GITHUB_REPO=openrace-data
GITHUB_BRANCH=main

# Discord channel webhook for push summaries. Leave empty to skip. Actions secret: DISCORD_WEBHOOK_URL.
DISCORD_WEBHOOK_URL=

# openrace-api resync endpoint. Placeholder until openrace-api exists; empty = skip.
# Actions secret: SYNC_WEBHOOK_URL.
SYNC_WEBHOOK_URL=
