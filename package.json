{
  "name": "openrace-data",
  "version": "0.1.0",
  "private": true,
  "description": "Source-of-truth race data for OpenRace (openrace.vn): JSON records, ingestion, git audit trail.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "tsx scripts/validate.ts",
    "schema": "tsx scripts/schema.ts",
    "check": "tsx scripts/check.ts",
    "edit": "tsx scripts/edit.ts",
    "sync": "tsx scripts/sync-cli.ts",
    "agent-read": "tsx scripts/agent-read.ts",
    "renormalize": "tsx scripts/renormalize.ts",
    "notify:discord": "tsx scripts/notify-discord.ts",
    "notify:sync": "tsx scripts/notify-sync.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "node-html-parser": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
