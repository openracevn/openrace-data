{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 120,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "website": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "links": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "kind": {
              "type": "string",
              "enum": [
                "official",
                "facebook"
              ]
            },
            "foundOn": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "url",
            "kind",
            "foundOn"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "website"
    ],
    "additionalProperties": false
  },
  "$id": "https://openrace.vn/schema/v3/organizers.schema.json",
  "title": "OpenRace organizers (data/organizers.json)",
  "x-schema-version": 3
}
