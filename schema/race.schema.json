{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "slug": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "types": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "road_run",
          "trail_run",
          "city_trail",
          "obstacle_run",
          "triathlon",
          "duathlon",
          "aquathlon",
          "aquabike",
          "swimrun",
          "open_water_swim",
          "pool_swim",
          "swim",
          "road_cycle",
          "mtb",
          "other"
        ]
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "seriesId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "organizerId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "organizer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "coOrganizerIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "edition": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "meters": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "road_run",
                  "trail_run",
                  "city_trail",
                  "obstacle_run",
                  "triathlon",
                  "duathlon",
                  "aquathlon",
                  "aquabike",
                  "swimrun",
                  "open_water_swim",
                  "pool_swim",
                  "swim",
                  "road_cycle",
                  "mtb",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "elevationGain": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "label",
          "meters",
          "type",
          "elevationGain"
        ],
        "additionalProperties": false
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "venue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "venue",
        "city"
      ],
      "additionalProperties": false
    },
    "geo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": 8,
              "maximum": 24
            },
            "lng": {
              "type": "number",
              "minimum": 102,
              "maximum": 110
            },
            "source": {
              "type": "string",
              "enum": [
                "maps_link",
                "nominatim",
                "manual",
                "place"
              ]
            },
            "precision": {
              "type": "string",
              "enum": [
                "venue",
                "ward",
                "province"
              ]
            },
            "current": {
              "type": "object",
              "properties": {
                "province": {
                  "type": "string",
                  "pattern": "^\\d{2}$"
                },
                "ward": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{5}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "province",
                "ward"
              ],
              "additionalProperties": false
            },
            "legacy": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "province": {
                      "type": "string",
                      "pattern": "^\\d{2}$"
                    },
                    "district": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^\\d{3}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "ward": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^\\d{5}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "province",
                    "district",
                    "ward"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "access": {
              "type": "string",
              "enum": [
                "road",
                "flight_or_ferry"
              ]
            },
            "fromPlaces": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "km": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minutes": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "road",
                      "straight_line"
                    ]
                  },
                  "near": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "km",
                  "minutes",
                  "method",
                  "near"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "lat",
            "lng",
            "source",
            "precision",
            "current",
            "legacy",
            "access",
            "fromPlaces"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "distance": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "super_early",
              "early",
              "regular",
              "late",
              "group",
              "other"
            ]
          },
          "audience": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "resident",
                  "non_resident"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "inferred": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "from",
                "to"
              ]
            }
          },
          "site": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "priceOriginal": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "amount": {
                    "type": "number"
                  }
                },
                "required": [
                  "currency",
                  "amount"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "fxRate": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "asOf": {
                    "type": "string"
                  }
                },
                "required": [
                  "rate",
                  "asOf"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "distance",
          "tier",
          "kind",
          "audience",
          "price",
          "from",
          "to",
          "inferred",
          "site"
        ],
        "additionalProperties": false
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "registrationStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "open",
            "closing_soon",
            "sold_out",
            "closed",
            "cancelled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "site",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "official",
              "seller",
              "facebook",
              "rules",
              "results",
              "news",
              "other"
            ]
          },
          "foundOn": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "kind",
          "foundOn"
        ],
        "additionalProperties": false
      }
    },
    "participants": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "approx": {
              "type": "boolean"
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "count",
            "approx",
            "sourceUrl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "name",
          "types",
          "date",
          "endDate",
          "seriesId",
          "organizerId",
          "organizer",
          "coOrganizerIds",
          "edition",
          "courses",
          "location",
          "geo",
          "prices",
          "currency",
          "registrationStatus",
          "registrations",
          "links",
          "participants"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "value",
          "reason",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "official",
              "seller",
              "reference"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "lastCheckedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "lastChangedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "extracted": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "site",
          "role",
          "url",
          "lastCheckedAt",
          "lastChangedAt",
          "extracted"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "single-sourced",
        "multi-sourced",
        "conflicting"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "types",
    "date",
    "endDate",
    "seriesId",
    "organizerId",
    "organizer",
    "edition",
    "courses",
    "location",
    "geo",
    "prices",
    "currency",
    "registrationStatus",
    "registrations",
    "links",
    "participants",
    "flags",
    "overrides",
    "sources",
    "confidence",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://openrace.vn/schema/v3/race.schema.json",
  "title": "OpenRace race (data/races/<slug>-<year>.json)",
  "x-schema-version": 3
}
